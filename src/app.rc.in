// The executable's icon and version resource. Configured by CMake from the project version;
// the icon is packaging/windows/signature-master.ico. UTF-8, for the company's legal name.
#pragma code_page(65001)
#include <windows.h>

IDI_ICON1 ICON "@SM_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sigmastone OÜ"
            VALUE "FileDescription", "Signing desk for Sigmastone releases"
            VALUE "FileVersion", "@SM_VERSION_FULL@"
            VALUE "InternalName", "signature-master"
            VALUE "LegalCopyright", "Copyright © 2026 Sigmastone OÜ"
            VALUE "OriginalFilename", "signature-master.exe"
            VALUE "ProductName", "Signature Master"
            VALUE "ProductVersion", "@SM_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
